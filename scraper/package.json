{
  "name": "continua-scraper",
  "version": "0.1.0",
  "description": "Continua Web Intelligence / Data Ingestion Engine — discovers, crawls, and extracts raw financial material for the Continua data layer. Deployed as its own service, separate from continua-data (backend/), so heavy crawl/OCR work never competes with the live price/WebSocket process for memory or CPU.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}