# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WS_PORT=4001
LOG_LEVEL=info

# ── Database (Supabase Postgres — same project as the app) ──
# AfriFinance Data writes into its own `market` schema in the SAME
# Postgres instance the app already uses, so it stays one project.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ── Cache ─────────────────────────────────────────────────
# "memory" works with zero setup for dev. Switch to "redis" in prod.
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# ── NSE data source ───────────────────────────────────────
# AfriFinance Data never lets the app talk to the provider directly.
# Point this at your licensed/authorized NSE feed once you have one.
# Until then NSE_CLIENT_MODE=mock runs a realistic synthetic feed so
# every downstream layer (ingestion → storage → API → app) can be
# built and tested end-to-end today.
NSE_CLIENT_MODE=mock
NSE_API_BASE_URL=
NSE_API_KEY=

# ── Ingestion cadence ─────────────────────────────────────
PRICE_POLL_INTERVAL_MS=5000
FINANCIALS_SYNC_CRON=0 2 * * *
CORPORATE_ACTIONS_SYNC_CRON=0 3 * * *

# ── API auth ──────────────────────────────────────────────
API_KEY_AUTH_ENABLED=true
# Fixed dev key so local dev/CI works before any real key is issued.
# NEVER set this in a deployed environment — issue real keys instead:
#   npm run apikey:create -- "Some Customer Name"
DEV_API_KEY=dev-local-only-key

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_DEFAULT=120

# ── Trading calendar ──────────────────────────────────────
# true = workers ignore NSE trading hours/days and poll continuously.
# Useful for demos/tests run outside market hours; leave false in prod.
IGNORE_TRADING_CALENDAR=false
